{
  "name": "torrent-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地 Torrent 种子管理器：扫描磁盘、解析种子内容、调用第三方工具打开",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
